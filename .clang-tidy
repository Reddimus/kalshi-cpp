# Exclusions:
# - bugprone-easily-swappable-parameters: (method, path, body) style APIs trip it constantly.
# - performance-enum-size: narrowing public enums would change the ABI for little gain.
# - optin.performance.Padding: public parameter structs are ordered for readability and
#   aggregate initialization, not layout.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  performance-*,
  -performance-enum-size,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-redundant-void-arg,
  modernize-use-using,
  readability-container-size-empty,
  readability-redundant-string-init,
  readability-make-member-function-const,
  misc-unused-using-decls,
  misc-definitions-in-headers,
  cppcoreguidelines-virtual-class-destructor,
  cppcoreguidelines-slicing
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include/kalshi|src)/.*'
FormatStyle: file
