#pragma once

/// @file version.hpp
/// @brief The SDK version, generated from `project(... VERSION)` in CMakeLists.txt.

namespace kalshi {

/// Full SDK version, "MAJOR.MINOR.PATCH".
constexpr const char* VERSION = "@PROJECT_VERSION@";

constexpr int VERSION_MAJOR = @PROJECT_VERSION_MAJOR@;

/// While VERSION_MAJOR is 0, a new minor version may break the API.
constexpr int VERSION_MINOR = @PROJECT_VERSION_MINOR@;

/// Patch releases fix bugs without changing the API.
constexpr int VERSION_PATCH = @PROJECT_VERSION_PATCH@;

} // namespace kalshi
